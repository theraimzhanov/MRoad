<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:colorBackground">@color/colorPrimary</item>
        <item name="layout_constraintLeft_toLeftOf">parent</item>
        <item name="layout_constraintRight_toRightOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>
    <style name="icon_flag">
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">31dp</item>
        <item name="android:layout_marginStart">7dp</item>
    </style>
    <style name="text_view_btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">22dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_marginStart">20dp</item>
    </style>
    <style name="setting_image">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>
    <style name="view_line">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1.4dp</item>
        <item name="android:background">@color/black</item>
    </style>

    <style name="radio_btn">
        <item name="android:textAlignment">textStart</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textSize">20dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
    </style>
    <style name="radio_btn_sett">
        <item name="android:layout_width">285dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:textSize">22dp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="center">
        <item name="layout_constraintLeft_toLeftOf">parent</item>
        <item name="layout_constraintRight_toRightOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>

    <style name="text_toolbar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="text_mosque_toolbar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:textColor">@color/colorPrimaryLight</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="text_lesson_toolbar">
        <item name="android:text">@string/lessons</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Theme.Menu" parent="Theme.AppCompat.Light">
        <item name="android:colorBackground">@color/colorPrimaryTool</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18dp</item>
    </style>
    <style name="Menu" parent="Theme.AppCompat.Light">
        <item name="android:colorBackground">@color/colorPrimaryTool</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18dp</item>
    </style>
    <style name="_card_view">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">71dp</item>
        <item name="cardBackgroundColor">@color/colorPrimaryTool</item>
        <item name="cardCornerRadius">5dp</item>
    </style>

    <style name="_card_view_icon">
        <item name="android:layout_width">37dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="cardBackgroundColor">@color/colorPrimary</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <style name="_card_view_img">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="_card_view_text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:layout_marginTop">47dp</item>
        <item name="android:textColor">@color/colorPrimaryLight</item>
    </style>

    <style name="_lesson_view_text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:textColor">@color/colorPrimaryLight</item>
    </style>

    <style name="card_view">
        <item name="android:layout_width">268dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginTop">631dp</item>
        <item name="android:layout_marginLeft">51dp</item>
    </style>


    <style name="con_style">
        <item name="android:layout_width">119dp</item>
        <item name="android:layout_height">104dp</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="tex_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="next_text">
        <item name="android:gravity">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13dp</item>
        <item name="android:textColor">@color/colorPrimaryLight</item>
    </style>

    <style name="add_btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_gravity">end</item>
    </style>

    <style name="add_icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:src">@drawable/ic_add</item>
    </style>

    <style name="add_text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">@string/add</item>
        <item name="android:textColor">@color/colorPrimaryLight</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textSize">13dp</item>
    </style>

    <style name="add_text_btn">
        <item name="android:layout_gravity">center</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@color/colorPrimaryLight</item>
    </style>
    <style name="add_photo_btn">
        <item name="android:layout_gravity">center</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16dp</item>
        <item name="android:text">@string/photo</item>
        <item name="android:textColor">@color/colorPrimaryLight</item>
    </style>


</resources>