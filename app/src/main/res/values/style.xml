<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="layout_constraintLeft_toLeftOf">parent</item>
        <item name="layout_constraintRight_toRightOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>

    <style name="text_toolbar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="img_toolbar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Theme.Menu" parent="Theme.AppCompat.Light">
        <item name="android:colorBackground">@color/muslim</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:textSize">20dp</item>


    </style>

    <style name="et_text">
        <item name="android:layout_width">312dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/et_shape</item>
        <item name="android:paddingStart">28dp</item>

    </style>

    <style name="btn_add_photo">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:background">@drawable/tv_shape</item>


    </style>

    <style name="tv_add_photo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:hint">@string/add_ph_tv</item>
        <item name="android:textSize">10dp</item>
    </style>

    <style name="tv_add_des">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:titleMarginStart">13dp</item>
        <item name="android:gravity">center</item>
        <item name="android:titleMarginEnd">13dp</item>
        <item name="android:hint">@string/text_photo</item>
        <item name="android:textSize">8dp</item>
    </style>


    <style name="btn_add_tv_size">
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">312dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:text">@string/tv_add_text_btn</item>
        <item name="android:textSize">16dp</item>
        <item name="android:background">@drawable/btn_dobav_shape</item>
    </style>


</resources>