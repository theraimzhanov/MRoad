<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="312dp"
        android:layout_height="117dp"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:cardBackgroundColor="@color/colorPrimaryTool"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/mg_name"
            android:layout_width="165dp"
            android:layout_height="40dp"
            android:textSize="15dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/text"
            android:layout_marginStart="12dp"
            android:text="”Фрунзе”"/>


        <TextView
            android:layout_width="157dp"
            android:id="@+id/mg_work_time"
            android:layout_height="@dimen/size_20dp"
            android:text="Круглосуточно"
            android:layout_marginTop="45dp"
            android:textColor="@color/text_letter"
            android:textSize="@dimen/size_12dp"
            android:layout_marginStart="@dimen/size_12dp"/>

        <TextView
            android:id="@+id/mg_phone"
            android:layout_marginTop="70dp"
            android:layout_width="157dp"
            android:textSize="10dp"
            android:layout_height="25dp"
            android:textColor="@color/text"
            android:layout_marginStart="12dp"
            android:text="+996 773‒92‒23‒33" />

        <TextView
            android:id="@+id/mg_address"
            android:layout_marginTop="95dp"
            android:textSize="10dp"
            android:layout_marginStart="12dp"
            android:layout_width="157dp"
            android:textColor="@color/text_letter"
            android:layout_height="18dp"
            android:text="Ул. Медерова 157 Бишкек" />

        <ImageView
            android:id="@+id/img_magazine"
            android:layout_width="132dp"
            android:layout_height="117dp"
            android:layout_marginStart="179dp"
            tools:srcCompat="@tools:sample/avatars" />


    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>