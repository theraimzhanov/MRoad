<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.menu.WorkFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/work_toolbar"
        style="@style/toolbar"
        android:background="@color/colorPrimaryTool"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.Menu"
        tools:ignore="MissingConstraints">
        <ImageView
            android:id="@+id/exitWork"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/workToolbarText"
            style="@style/text_mosque_toolbar" />
    </androidx.appcompat.widget.Toolbar>

    <ProgressBar
        android:id="@+id/loadingWork"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ScrollView
        android:id="@+id/layoutInfoWork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/work_toolbar">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_marginTop="30dp"
    android:layout_marginStart="21dp"
    android:layout_marginEnd="21dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layoutMainInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:id="@+id/companyForVacancy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/colorPrimaryLight"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:id="@+id/nameForVacancy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="6dp"
            android:textColor="@color/colorPrimaryLight"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/to"
                android:textSize="18sp"
                android:textColor="@color/colorPrimaryLight"
              />
            <TextView
                android:id="@+id/salaryForVacancy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:layout_marginStart="5dp"
                android:textColor="#FFC107"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LabelVal"
                android:textSize="18sp"
                android:layout_marginStart="5dp"
                android:textColor="@color/colorPrimaryLight"
               />
        </LinearLayout>
    </LinearLayout>
     <androidx.constraintlayout.widget.ConstraintLayout
         android:id="@+id/info"
         android:layout_width="0dp"
         android:layout_marginTop="20dp"
         app:layout_constraintTop_toBottomOf="@id/layoutMainInfo"
         app:layout_constraintStart_toStartOf="@id/layoutMainInfo"
         app:layout_constraintEnd_toEndOf="@id/layoutMainInfo"
         android:layout_height="wrap_content">
         <LinearLayout
             android:id="@+id/work_location"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintRight_toRightOf="parent"
             app:layout_constraintLeft_toLeftOf="parent"
             android:orientation="horizontal"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">
             <ImageView
                 android:layout_width="25dp"
                 android:layout_height="25dp"
                 android:text="@string/to"
                 android:background="#FFB800"
                 android:src="@drawable/ic_image_114__traced_"
                 android:textSize="18sp"
                 android:textColor="@color/colorPrimaryLight" />

           <TextView
               android:id="@+id/locationVacancy"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textSize="18sp"
               android:layout_marginStart="5dp"
               android:textColor="@color/colorPrimaryLight"
               />
         </LinearLayout>
         <LinearLayout
             android:id="@+id/work_time"
             app:layout_constraintTop_toBottomOf="@id/work_location"
             app:layout_constraintRight_toRightOf="parent"
             app:layout_constraintLeft_toLeftOf="parent"
             android:layout_marginTop="10dp"
             android:orientation="horizontal"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">
             <ImageView
                 android:layout_width="25dp"
                 android:layout_height="25dp"
                 android:text="@string/to"
                 android:background="#FFB800"
                 android:src="@drawable/ic_image_123__traced_"
                 android:textSize="18sp"
                 android:textColor="@color/colorPrimaryLight" />

             <TextView
                 android:id="@+id/timeVacancy"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:textSize="18sp"
                 android:layout_marginStart="5dp"
                 android:textColor="@color/colorPrimaryLight"
                  />
         </LinearLayout>
         <LinearLayout
             android:id="@+id/work_pro"
             app:layout_constraintTop_toBottomOf="@id/work_time"
             app:layout_constraintRight_toRightOf="parent"
             app:layout_constraintLeft_toLeftOf="parent"
             android:layout_marginTop="10dp"
             android:orientation="horizontal"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">
             <ImageView
                 android:layout_width="25dp"
                 android:layout_height="25dp"
                 android:text="@string/to"
                 android:background="#FFB800"
                 android:src="@drawable/ic_image_124__traced_"
                 android:textSize="18sp"
                 android:textColor="@color/colorPrimaryLight" />

             <TextView
                 android:id="@+id/proVacancy"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:textSize="18sp"
                 android:layout_marginStart="5dp"
                 android:textColor="@color/colorPrimaryLight" />
         </LinearLayout>
         <LinearLayout
             android:id="@+id/work_education"
             app:layout_constraintTop_toBottomOf="@id/work_pro"
             app:layout_constraintRight_toRightOf="parent"
             app:layout_constraintLeft_toLeftOf="parent"
             android:layout_marginTop="10dp"
             android:orientation="horizontal"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">
             <ImageView
                 android:layout_width="25dp"
                 android:layout_height="25dp"
                 android:text="@string/to"
                 android:background="#FFB800"
                 android:src="@drawable/ic_image_125__traced_"
                 android:textSize="18sp"
                 android:textColor="@color/colorPrimaryLight" />

             <TextView
                 android:id="@+id/educationVacancy"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:textSize="18sp"
                 android:layout_marginStart="5dp"
                 android:textColor="@color/colorPrimaryLight" />
         </LinearLayout>
         <LinearLayout
             android:id="@+id/work_requirements"
             app:layout_constraintTop_toBottomOf="@id/work_education"
             app:layout_constraintRight_toRightOf="parent"
             app:layout_constraintLeft_toLeftOf="parent"
             android:layout_marginTop="10dp"
             android:orientation="vertical"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">
             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="@string/requirements"
                 android:textSize="18sp"
                 android:textColor="@color/colorPrimaryLight" />
             <TextView
                 android:id="@+id/requirementsWork"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="5dp"
                 android:textSize="14sp"
                 android:textColor="@color/colorPrimaryLight" />
         </LinearLayout>
         <LinearLayout
             android:id="@+id/work_duties"
             app:layout_constraintTop_toBottomOf="@id/work_requirements"
             app:layout_constraintRight_toRightOf="parent"
             app:layout_constraintLeft_toLeftOf="parent"
             android:layout_marginTop="10dp"
             android:orientation="vertical"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">
             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="@string/labelOblation"
                 android:textSize="18sp"
                 android:textColor="@color/colorPrimaryLight" />
             <TextView
                 android:id="@+id/dutiesWork"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="5dp"
                 android:textSize="14sp"
                 android:textColor="@color/colorPrimaryLight" />
         </LinearLayout>
         <LinearLayout
             android:id="@+id/work_conditions"
             app:layout_constraintTop_toBottomOf="@id/work_duties"
             app:layout_constraintRight_toRightOf="parent"
             app:layout_constraintLeft_toLeftOf="parent"
             android:layout_marginTop="10dp"
             android:orientation="vertical"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">
             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="@string/labelCondition"
                 android:textSize="18sp"
                 android:textColor="@color/colorPrimaryLight" />
             <TextView
                 android:id="@+id/conditionsWork"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="5dp"
                 android:textSize="14sp"
                 android:textColor="@color/colorPrimaryLight" />
         </LinearLayout>
     </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/likeVacancy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/txtVacancy"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:background="#FFB800"
        android:layout_marginHorizontal="40dp"
        android:textColor="@color/colorPrimaryLight"
        android:paddingVertical="12dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintTop_toBottomOf="@id/info"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>