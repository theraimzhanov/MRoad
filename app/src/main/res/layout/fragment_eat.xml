<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.eat.EatFragment">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/toolbar"
        android:background="@color/colorPrimaryTool"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.Menu"
        tools:ignore="MissingConstraints">
        <TextView
            android:id="@+id/toolbar_text"
            style="@style/text_mosque_toolbar"
            android:text="@string/eat" />

    </androidx.appcompat.widget.Toolbar>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#8c212226"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_e_code"
            style="@style/_card_view"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="400dp"
            android:clickable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView style="@style/_card_view_icon">

                <ImageView
                    style="@style/_card_view_img"
                    android:src="@drawable/ic_e" />
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/_card_view_text"
                android:text="@string/e_code" />
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/btn_shop"
            style="@style/_card_view"
            android:layout_marginEnd="13dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@+id/btn_e_code"
            app:layout_constraintEnd_toStartOf="@+id/btn_e_code">
            <androidx.cardview.widget.CardView style="@style/_card_view_icon">
                <ImageView
                    style="@style/_card_view_img"
                    android:src="@drawable/ic_ishop" />
            </androidx.cardview.widget.CardView>
            <TextView
                style="@style/_card_view_text"
                android:text="@string/shop" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_cafe"
            style="@style/_card_view"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_shop"
            app:layout_constraintStart_toStartOf="@+id/btn_shop">
            <androidx.cardview.widget.CardView style="@style/_card_view_icon">
                <ImageView
                    style="@style/_card_view_img"
                    android:src="@drawable/ic_coffee_b" />
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/_card_view_text"
                android:text="@string/cafe" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_restaurant"
            style="@style/_card_view"
            android:layout_marginStart="13dp"
            app:layout_constraintStart_toEndOf="@+id/btn_cafe"
            app:layout_constraintTop_toTopOf="@+id/btn_cafe">
            <androidx.cardview.widget.CardView style="@style/_card_view_icon">
                <ImageView
                    style="@style/_card_view_img"
                    android:src="@drawable/ic_resturan" />
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/_card_view_text"
                android:text="@string/restorany" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_fast_food"
            style="@style/_card_view"
            android:layout_marginStart="13dp"
            app:layout_constraintStart_toEndOf="@+id/btn_restaurant"
            app:layout_constraintTop_toTopOf="@+id/btn_restaurant">

            <androidx.cardview.widget.CardView style="@style/_card_view_icon">

                <ImageView
                    style="@style/_card_view_img"
                    android:src="@drawable/ic_fast_food" />
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/_card_view_text"
                android:text="@string/fast_food" />
        </androidx.cardview.widget.CardView>





    </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>