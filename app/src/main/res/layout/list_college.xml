<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:cardBackgroundColor="@color/colorPrimaryTool"
        app:cardCornerRadius="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/cl_name"
            android:layout_width="165dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="5dp"
            android:text="Исламский институт им.Кутайба ибн Муслим"
            android:textColor="@color/text"
            android:textSize="15dp" />

        <TextView
            android:id="@+id/cl_address"
            android:layout_width="157dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="50dp"
            android:text="​Касымалы Баялинова,
187 Бишкек, 720014"
            android:textColor="@color/text_letter"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/cl_phone"
            android:layout_width="120dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="95dp"
            android:text="+996 773‒92‒23‒33"
            android:textColor="@color/text"
            android:textSize="10dp" />

        <ImageView
            android:id="@+id/img_college"
            android:layout_width="132dp"
            android:layout_height="117dp"
            android:layout_marginStart="179dp"
            tools:srcCompat="@tools:sample/avatars" />


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>