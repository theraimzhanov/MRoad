<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="312dp"
        android:layout_height="117dp"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:cardBackgroundColor="@color/colorPrimaryTool"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/res_name"
            android:layout_width="165dp"
            android:layout_height="40dp"
            android:textSize="15dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/text"
            android:layout_marginStart="12dp"
            android:text=" Resto Son-Kol"/>


        <TextView
            android:layout_width="157dp"
            android:id="@+id/res_ms_room_yes"
            android:layout_height="@dimen/size_20dp"
            android:text="Намазкана"
            android:layout_marginTop="45dp"
            android:textColor="@color/text_letter"
            android:textSize="@dimen/size_12dp"
            android:layout_marginStart="@dimen/size_12dp"/>

        <TextView
            android:id="@+id/res_phone"
            android:layout_width="157dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="70dp"
            android:text="+996 773‒92‒23‒33"
            android:textColor="@color/text"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/res_address"
            android:layout_marginTop="95dp"
            android:textSize="10dp"
            android:layout_marginStart="12dp"
            android:layout_width="157dp"
            android:textColor="@color/text_letter"
            android:layout_height="18dp"
            android:text="Ул. Медерова 157 Бишкек" />

        <ImageView
            android:id="@+id/img_restaurant"
            android:layout_width="132dp"
            android:layout_height="117dp"
            android:layout_marginStart="179dp"
            tools:srcCompat="@tools:sample/avatars" />


    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>