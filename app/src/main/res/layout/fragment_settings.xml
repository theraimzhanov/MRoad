<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.menu.SettingsFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/home_toolbar"
        style="@style/toolbar"
        android:background="@color/colorPrimaryTool"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.Menu"
        tools:ignore="MissingConstraints">
        <TextView
            android:text="@string/setting"
            android:id="@+id/toolbar_text"
            style="@style/text_mosque_toolbar" />

        <ImageView
            android:id="@+id/exitSetting"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:layout_height="wrap_content"/>

    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cons_setting1"
        android:layout_width="340dp"
        android:layout_height="240dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/setting_shape_abdu"
        android:layout_marginTop="115dp">

        <RadioGroup
            android:id="@+id/group_lang"
            android:layout_width="295dp"
            android:layout_height="match_parent"
            style="@style/center"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/city_picker_sett"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/radio_btn_sett"
            android:text="@string/city_picker"/>

        <RadioButton
            android:id="@+id/btn_ru"
            android:layout_width="285dp"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            style="@style/radio_btn_sett"
            android:text="@string/russia"/>

        <RadioButton
            android:id="@+id/btn_ky"
            android:layout_width="285dp"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            style="@style/radio_btn_sett"
            android:text="@string/kyrgyzsha"/>

        <RadioButton
            android:id="@+id/btn_eng"
            android:layout_width="285dp"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            style="@style/radio_btn_sett"
            android:text="@string/english"/>

        </RadioGroup>

    <LinearLayout
        android:layout_width="45dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_city_picker"
            style="@style/icon_flag"
            android:src="@drawable/city_picker"/>

        <ImageView
            style="@style/icon_flag"
            android:src="@drawable/russia"
            app:layout_constraintStart_toStartOf="@id/icon_city_picker"
            app:layout_constraintTop_toBottomOf="@id/icon_city_picker"/>

        <ImageView
            style="@style/icon_flag"
            android:src="@drawable/kyrgyz"
            app:layout_constraintStart_toStartOf="@id/icon_city_picker"
            app:layout_constraintTop_toBottomOf="@id/icon_city_picker"/>

        <ImageView
            style="@style/icon_flag"
            android:src="@drawable/usa"
            app:layout_constraintStart_toStartOf="@id/icon_city_picker"
            app:layout_constraintTop_toBottomOf="@id/icon_city_picker"/>

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="340dp"
        android:layout_height="260dp"
        android:background="@drawable/setting_shape_abdu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cons_setting1"
        android:layout_marginTop="60dp">
        
        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/site"
                android:text="@string/muslim_road_site"
                style="@style/text_view_btn"/>

            <TextView
                android:text="@string/instagram_muslim_road"
                style="@style/text_view_btn"/>

            <TextView
                android:text="@string/facebook_muslim_road"
                style="@style/text_view_btn"/>

            <TextView
                android:text="@string/vkontakte_muslim_road"
                style="@style/text_view_btn"/>

            <TextView
                android:text="@string/odnoclassnic_muslim_road"
                style="@style/text_view_btn"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="55dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                style="@style/setting_image"
                android:src="@drawable/muslim_road_city"/>

            <ImageView
                style="@style/setting_image"
                android:src="@drawable/instagram"/>

            <ImageView
                style="@style/setting_image"
                android:src="@drawable/facebook"/>

            <ImageView
                style="@style/setting_image"
                android:src="@drawable/vkontacte"/>

            <ImageView
                style="@style/setting_image"
                android:src="@drawable/muslim_road_city"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>