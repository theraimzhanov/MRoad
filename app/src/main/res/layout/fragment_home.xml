<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/img_compas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.homefragment.HomeFragment">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/toolbar"
        android:background="#06483A"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.Menu"
        tools:ignore="MissingConstraints">
        <TextView
            android:text="12.09.2022"
            android:id="@+id/toolbar_text"
            style="@style/text_meshet_toolbar" />
     <ImageView
         android:id="@+id/btn_menu"
         android:layout_width="25dp"
         android:layout_height="15dp"
         android:src="@drawable/icon_aa"
         android:layout_gravity="end"
         android:layout_marginEnd="30dp"/>
    </androidx.appcompat.widget.Toolbar>


