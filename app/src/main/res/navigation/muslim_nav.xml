<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/muslim_nav"
    app:startDestination="@id/splashFragment">
    <fragment
        android:id="@+id/lessonsFragment"
        android:name="com.motion.muslimcollection.ui.lessons.LessonsFragment"
        android:label="fragment_lessons"
        tools:layout="@layout/fragment_lessons" >
        <action
            android:id="@+id/action_lessonsFragment_to_namazFragment"
            app:destination="@id/namazFragment" />
        <action
            android:id="@+id/action_lessonsFragment_to_eatFragment2"
            app:destination="@id/eatFragment" />
    </fragment>
    <fragment
        android:id="@+id/namazFragment"
        android:name="com.motion.muslimcollection.ui.lessons.namaz.NamazFragment"
        android:label="fragment_namaz"
        tools:layout="@layout/fragment_namaz" >
        <action
            android:id="@+id/action_namazFragment_to_pliyerFragment"
            app:destination="@id/pliyerFragment" />
        <argument
            android:name="lessons"
            app:argType="integer"
            android:defaultValue="0" />
        <action
            android:id="@+id/action_namazFragment_to_lessonsFragment2"
            app:destination="@id/lessonsFragment" />
    </fragment>
    <fragment
        android:id="@+id/pliyerFragment"
        android:name="com.motion.muslimcollection.ui.lessons.pliyer.PliyerFragment"
        android:label="fragment_pliyer"
        tools:layout="@layout/fragment_pliyer" >
        <argument
            android:name="audio"
            app:argType="integer"
            android:defaultValue="0" />
        <action
            android:id="@+id/action_pliyerFragment_to_namazFragment"
            app:destination="@id/namazFragment" />
    </fragment>
    <fragment
        android:id="@+id/mosquesFragment"
        android:name="com.motion.muslimcollection.ui.mosque.mosques.MosquesFragment"
        android:label="fragment_mosques"
        tools:layout="@layout/fragment_mosques" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.motion.muslimcollection.ui.homefragment.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_mosqueFragment"
            app:destination="@id/mosqueFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment2"
            app:destination="@id/settingsFragment2" />
        <action
            android:id="@+id/action_homeFragment_to_appFragment"
            app:destination="@id/appFragment" />
        <action
            android:id="@+id/action_homeFragment_to_workFragment"
            app:destination="@id/workFragment" />
    </fragment>
    <fragment
        android:id="@+id/mosqueFragment"
        android:name="com.motion.muslimcollection.ui.mosque.MosqueFragment"
        android:label="fragment_mosque"
        tools:layout="@layout/fragment_mosque" >
        <action
            android:id="@+id/action_mosqueFragment_to_eatFragment2"
            app:destination="@id/eatFragment" />
        <action
            android:id="@+id/action_mosqueFragment_to_homeFragment2"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_mosqueFragment_to_madrasahFragment"
            app:destination="@id/madrasahFragment" />
        <action
            android:id="@+id/action_mosqueFragment_to_mosquesFragment"
            app:destination="@id/mosquesFragment" />
        <action
            android:id="@+id/action_mosqueFragment_to_mosqueCollegeFragment"
            app:destination="@id/mosqueCollegeFragment" />
        <action
            android:id="@+id/action_mosqueFragment_to_roomFragment"
            app:destination="@id/roomFragment" />
        <action
            android:id="@+id/action_mosqueFragment_to_libraryFragment"
            app:destination="@id/libraryFragment" />
        <action
            android:id="@+id/action_mosqueFragment_to_universityFragment"
            app:destination="@id/universityFragment" />

    </fragment>
    <fragment
        android:id="@+id/eatFragment"
        android:name="com.motion.muslimcollection.ui.eat.EatFragment"
        android:label="fragment_eat"
        tools:layout="@layout/fragment_eat" >
        <action
            android:id="@+id/action_eatFragment_to_lessonsFragment"
            app:destination="@id/lessonsFragment" />
        <action
            android:id="@+id/action_eatFragment_to_mosqueFragment"
            app:destination="@id/mosqueFragment" />
        <action
            android:id="@+id/action_eatFragment_to_cafeFragment"
            app:destination="@id/cafeFragment" />
        <action
            android:id="@+id/action_eatFragment_to_restaurantFragment"
            app:destination="@id/restaurantFragment" />
        <action
            android:id="@+id/action_eatFragment_to_fastFoodFragment"
            app:destination="@id/fastFoodFragment" />
        <action
            android:id="@+id/action_eatFragment_to_magazineFragment"
            app:destination="@id/magazineFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment2"
        android:name="com.motion.muslimcollection.ui.menu.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" >
        <action
            android:id="@+id/action_settingsFragment2_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/appFragment"
        android:name="com.motion.muslimcollection.ui.menu.AppFragment"
        android:label="fragment_app"
        tools:layout="@layout/fragment_app" >
        <action
            android:id="@+id/action_appFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/workFragment"
        android:name="com.motion.muslimcollection.ui.menu.WorkFragment"
        android:label="fragment_work"
        tools:layout="@layout/fragment_work" />
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.motion.muslimcollection.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/madrasahFragment"
        android:name="com.motion.muslimcollection.ui.mosque.mosque_madrasah.MadrasahFragment"
        android:label="fragment_madrasah"
        tools:layout="@layout/fragment_madrasah" />
    <fragment
        android:id="@+id/mosqueCollegeFragment"
        android:name="com.motion.muslimcollection.ui.mosque.mosque_college.MosqueCollegeFragment"
        android:label="fragment_mosque_college"
        tools:layout="@layout/fragment_mosque_college" />
    <fragment
        android:id="@+id/roomFragment"
        android:name="com.motion.muslimcollection.ui.mosque.mosque_room.RoomFragment"
        android:label="fragment_room"
        tools:layout="@layout/fragment_room" />
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.motion.muslimcollection.ui.mosque.mosque_library.LibraryFragment"
        android:label="fragment_library"
        tools:layout="@layout/fragment_library" />
    <fragment
        android:id="@+id/universityFragment"
        android:name="com.motion.muslimcollection.ui.mosque.mosque_university.UniversityFragment"
        android:label="fragment_mosque_university"
        tools:layout="@layout/fragment_mosque_university" />
    <fragment
        android:id="@+id/cafeFragment"
        android:name="com.motion.muslimcollection.ui.eat.cafe.CafeFragment"
        android:label="fragment_cafe"
        tools:layout="@layout/fragment_cafe" />
    <fragment
        android:id="@+id/restaurantFragment"
        android:name="com.motion.muslimcollection.ui.eat.restaurant.RestaurantFragment"
        android:label="fragment_restaurant"
        tools:layout="@layout/fragment_restaurant" />
    <fragment
        android:id="@+id/fastFoodFragment"
        android:name="com.motion.muslimcollection.ui.eat.fastfood.FastFoodFragment"
        android:label="fragment_fast_food"
        tools:layout="@layout/fragment_fast_food" />
    <fragment
        android:id="@+id/magazineFragment"
        android:name="com.motion.muslimcollection.ui.eat.magazine.MagazineFragment"
        android:label="fragment_magazine"
        tools:layout="@layout/fragment_magazine" />

</navigation>